# ─── SADEB — variáveis de ambiente (copiar para .env.local em dev; no Vercel: Settings → Environment Variables)

# ── Base de dados DBAT (Txt as Database via GitHub Contents API)
# Sem GITHUB_TOKEN/GITHUB_REPO os .txt ficam em ./data (só serve para desenvolvimento:
# no Vercel o disco é efémero).
GITHUB_TOKEN=            # fine-grained token, só este repositório, permissão "Contents: Read and write"
GITHUB_REPO=JerryAlafo/SADEB
GITHUB_BRANCH=dados      # ramo só de dados (criado automaticamente; o vercel.json desliga os deploys dele)
GITHUB_DATA_PATH=data    # pasta dentro do ramo
SADEB_GITHUB_CACHE_MS=1500

# ── Dados iniciais
# 0 = só o administrador abaixo (recomendado no Vercel); por omissão cria as contas de demonstração do README.
SADEB_SEED_DEMO=0
SADEB_ADMIN_EMAIL=admin@sadeb.ac.mz
SADEB_ADMIN_SENHA=       # mínimo 12 caracteres

# ── Segurança
SADEB_CHAVE_CIFRA=       # segredo longo e aleatório (ex.: openssl rand -base64 48); cifra o retrato do documento
SADEB_LATENCIA_MS=0      # espera simulada por pedido (por omissão 2000 ms)

# ── Verificação de identidade (Regula Forensics)
SADEB_EXIGIR_VERIFICACAO=1             # 0 = registo sem OCR/liveness/face match
REGULA_DOCREADER_URL=                  # ex.: https://docreader.exemplo.mz  (imagem Docker regulaforensics/docreader, porta 8080)
REGULA_FACEAPI_URL=                    # ex.: https://faceapi.exemplo.mz    (imagem Docker regulaforensics/face-api, porta 41101)
NEXT_PUBLIC_REGULA_FACEAPI_URL=        # URL da Face API visto pelo browser, se diferente (tem de ser HTTPS)
REGULA_DOCREADER_LICENSE=              # licença em base64, se não estiver montada no servidor
REGULA_AUTHORIZATION=                  # opcional: cabeçalho Authorization se os serviços estiverem atrás de um proxy
REGULA_LIMIAR_FACEMATCH=75             # semelhança mínima (%)
REGULA_MAX_TENTATIVAS=5
REGULA_EXIGIR_AUTENTICIDADE=0          # 1 = recusar documentos com falha na verificação de autenticidade
REGULA_TIMEOUT_MS=45000
REGULA_SIMULADO=0                      # 1 = respostas fictícias (em dev é automático quando não há URLs)
